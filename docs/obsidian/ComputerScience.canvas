		{"id":"4990f01178f2aa95","type":"text","text":"list보다 성능 우수","x":976,"y":-240,"width":250,"height":60},
		{"id":"0be724e4525cb78b","type":"text","text":"list는?\n인덱싱 접근 불가능->입구부터 순차적 접근","x":976,"y":-140,"width":250,"height":100},
